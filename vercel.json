{
  "framework": null,
  "outputDirectory": "public",
  "buildCommand": "set -- ${GOOGLE_CLIENT_ID:-}; printf '{\"clientId\":\"%s\"}' \"${1:-}\" > public/google-config.json",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/google-config.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
